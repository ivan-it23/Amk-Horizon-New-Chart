/////////////////////////////////////////////////////////////////////////////
//
// Значок
//

// Значок с наименьшим значением идентификатора помещается первым, чтобы гарантировать использование
// идентичного значка приложения для всех систем.

IDI_AMKHORIZONNEWCHART       ICON         "Amk-Horizon-New-Chart.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// VERSIONINFO
//
// Метаданные exe-файла, видимые в Properties → Details.
// Версия читается из AppVersion.h, чтобы избежать дублирования значений.
// Используется антивирусами, инвентарными системами (SCCM/Intune/GPO) и
// SmartScreen для идентификации приложения.
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L                       // VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L                       // VOS_NT_WINDOWS32
 FILETYPE 0x1L                         // VFT_APP
 FILESUBTYPE 0x0L                      // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0419 = русский язык (1049), 04B0 = Unicode codepage (1200)
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "ООО НПФ ""АМК ГОРИЗОНТ"""
            VALUE "FileDescription",  "AMK Horizon New Chart"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "Amk-Horizon-New-Chart"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ООО НПФ ""АМК ГОРИЗОНТ"""
            VALUE "OriginalFilename", "Amk-Horizon-New-Chart.exe"
            VALUE "ProductName",      "AMK Horizon New Chart"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Меню
//

IDC_AMKHORIZONNEWCHART MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Открыть файл данных...",   IDM_OPEN_FILE
        MENUITEM SEPARATOR
        MENUITEM "Вы&ход",                    IDM_EXIT
    END

    MENUITEM "&Настройки подключения",       IDM_DEVICE_CONNECT
    MENUITEM "&Метрология",                  IDM_DEVICE_METROLOGY
    MENUITEM "&Конструктор файлов",          IDM_FILE_CONSTRUCTOR

    POPUP "&Заметки"
    BEGIN
        MENUITEM "&Журнал заметок текущего файла...", IDM_NOTES_JOURNAL
    END

    MENUITEM "&Логи",                        IDM_DEVICE_LOG
    MENUITEM "&Проверить обновления",        IDM_CHECK_UPDATES
    MENUITEM "&Документация",                IDM_DOCUMENTATION
END


