    LTEXT           "AIR_5_F_2",IDC_STATIC,200,162,45,10
    EDITTEXT        IDC_METRO_AIR_10,250,160,55,12,ES_AUTOHSCROLL

    // MIN (right column)
    LTEXT           "MIN_R2_T1_F_1",IDC_STATIC,315,32,65,10
    EDITTEXT        IDC_METRO_MIN_1,385,30,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R1_T2_F_1",IDC_STATIC,315,46,65,10
    EDITTEXT        IDC_METRO_MIN_2,385,44,55,12,ES_AUTOHSCROLL
