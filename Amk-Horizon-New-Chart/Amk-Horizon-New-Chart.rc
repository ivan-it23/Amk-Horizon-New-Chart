    EDITTEXT        IDC_METRO_SIGNATURE32_EDIT,225,256,280,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "palette",IDC_STATIC,175,274,30,10
    EDITTEXT        IDC_METRO_SIGNATUREPAL_EDIT,210,272,50,12,ES_AUTOHSCROLL | ES_READONLY

    // selected_key panel
    GROUPBOX        "selected_key",IDC_STATIC,165,303,350,70
    // 24 bits
