LANGUAGE 25, 1

/////////////////////////////////////////////////////////////////////////////
//
// Значок
//

// Значок с наименьшим значением идентификатора помещается первым, чтобы гарантировать использование
// идентичного значка приложения для всех систем.

IDI_AMKHORIZONNEWCHART       ICON         "Amk-Horizon-New-Chart.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Меню
//

IDC_AMKHORIZONNEWCHART MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Открыть файл данных...",   IDM_OPEN_FILE
        MENUITEM SEPARATOR
        MENUITEM "Вы&ход",                    IDM_EXIT
    END

    POPUP "&Прибор"
    BEGIN
        MENUITEM "&Подключить...",            IDM_DEVICE_CONNECT
        MENUITEM "&Отключить",                IDM_DEVICE_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&Старт опроса",             IDM_DEVICE_START
        MENUITEM "С&топ опроса",              IDM_DEVICE_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Очистить данные",          IDM_DEVICE_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "Папка &записи...",          IDM_DEVICE_RECORD_FOLDER
        MENUITEM "Открыть папку записи",      IDM_DEVICE_OPEN_FOLDER
    END

    POPUP "&Справка"
    BEGIN
        MENUITEM "&О программе...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Ускоритель
//

IDC_AMKHORIZONNEWCHART ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Диалоговое окно
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "О программе Amk-Horizon-New-Chart"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "Amk-Horizon-New-Chart, Версия 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "(c) 2025",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "ОК",IDOK,113,41,50,14,WS_GROUP
END

IDD_SERIAL_STATUS DIALOGEX 0, 0, 220, 185
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Подключение к прибору"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "COM-порт:",IDC_STATIC,10,12,40,10
    COMBOBOX        IDC_SERIAL_PORT_COMBO,55,10,80,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Обновить",IDC_SERIAL_CONNECT_BTN,140,9,70,14
    
    GROUPBOX        "Статус",IDC_STATIC,10,30,200,55
    LTEXT           "Состояние:",IDC_STATIC,18,42,45,10
    LTEXT           "Отключено",IDC_SERIAL_STATUS_LABEL,65,42,140,10
    LTEXT           "Кадр:",IDC_STATIC,18,54,25,10
    LTEXT           "0",IDC_SERIAL_FRAME_LABEL,65,54,50,10
    LTEXT           "Пакеты:",IDC_STATIC,18,66,35,10
    LTEXT           "0 / 0",IDC_SERIAL_PACKETS_LABEL,65,66,50,10
    LTEXT           "",IDC_SERIAL_INFO_LABEL,120,54,85,22
    
    GROUPBOX        "Запись в файл",IDC_STATIC,10,88,200,55
    AUTOCHECKBOX    "Записывать данные",IDC_SERIAL_RECORD_CHECK,18,100,85,10
    LTEXT           "Файл:",IDC_STATIC,18,113,25,10
    LTEXT           "Не записывается",IDC_SERIAL_RECORD_STATUS,45,113,160,10
    LTEXT           "Записано:",IDC_STATIC,18,125,40,10
    LTEXT           "0 кадров",IDC_SERIAL_RECORD_FRAMES,60,125,50,10
    PUSHBUTTON      "...",IDC_SERIAL_BROWSE_BTN,175,98,30,14
    PUSHBUTTON      "Открыть",IDC_SERIAL_OPEN_FOLDER_BTN,140,122,65,14
    
    PUSHBUTTON      "Подключить",IDC_SERIAL_START_BTN,10,148,65,18
    PUSHBUTTON      "Отключить",IDC_SERIAL_STOP_BTN,80,148,65,18
    PUSHBUTTON      "Закрыть",IDCANCEL,150,148,60,18
    
    PUSHBUTTON      "Очистить данные",IDC_SERIAL_CLEAR_BTN,10,168,100,14
END

IDD_SCHEMATIC_DIALOG DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_VISIBLE
EXSTYLE WS_EX_APPWINDOW
CAPTION "Схема прибора"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Схема прибора",IDC_STATIC,5,5,420,75
    CONTROL         "",IDC_SCHEMATIC_AREA,"Static",SS_BLACKFRAME | WS_BORDER,10,15,410,60
    
    LTEXT           "Частота:",IDC_STATIC,5,88,35,10
    COMBOBOX        IDC_FREQUENCY_COMBO,43,86,65,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Ось X:",IDC_STATIC,120,88,30,10
    COMBOBOX        IDC_XAXIS_TYPE_COMBO,153,86,80,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    GROUPBOX        "Доступные кривые",IDC_STATIC,5,102,255,140
    CONTROL         "",IDC_CURVE_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,10,113,245,125

    GROUPBOX        "Быстрые пресеты",IDC_STATIC,265,102,160,125
    PUSHBUTTON      "Все ампл. R1",IDC_PRESET_ALL_AMP_R1,270,113,72,16
    PUSHBUTTON      "Все ампл. R2",IDC_PRESET_ALL_AMP_R2,348,113,72,16
    PUSHBUTTON      "Отн. ампл.",IDC_PRESET_RATIOS,270,132,72,16
    PUSHBUTTON      "Разн. фаз",IDC_PRESET_DIFFERENCES,348,132,72,16
    PUSHBUTTON      "УЭС",IDC_PRESET_RHO_SMT,270,151,72,16
    PUSHBUTTON      "Симм. фазы",IDC_PRESET_PHASE_SMT,348,151,72,16
    PUSHBUTTON      "Температура",IDC_PRESET_TEMPERATURE,270,170,150,16
    PUSHBUTTON      "Ампл. молч. пер.",IDC_PRESET_SILENT_AMPL,270,189,150,16
    PUSHBUTTON      "Разн. фаз молч. пер.",IDC_PRESET_SILENT_DPH,270,208,150,16

    DEFPUSHBUTTON   "Применить",IDC_APPLY_SETTINGS,270,230,72,18
    PUSHBUTTON      "Отмена",IDCANCEL,348,230,72,18
END

