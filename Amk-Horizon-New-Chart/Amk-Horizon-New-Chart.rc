    EDITTEXT        IDC_METRO_MIN_3,385,58,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R1_T4_F_1",IDC_STATIC,315,74,65,10
    EDITTEXT        IDC_METRO_MIN_4,385,72,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R2_T5_F_1",IDC_STATIC,315,88,65,10
    EDITTEXT        IDC_METRO_MIN_5,385,86,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R2_T1_F_2",IDC_STATIC,315,106,65,10
    EDITTEXT        IDC_METRO_MIN_6,385,104,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R1_T2_F_2",IDC_STATIC,315,120,65,10
    EDITTEXT        IDC_METRO_MIN_7,385,118,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R2_T3_F_2",IDC_STATIC,315,134,65,10
    EDITTEXT        IDC_METRO_MIN_8,385,132,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R1_T4_F_2",IDC_STATIC,315,148,65,10
    EDITTEXT        IDC_METRO_MIN_9,385,146,55,12,ES_AUTOHSCROLL
    LTEXT           "MIN_R2_T5_F_2",IDC_STATIC,315,162,65,10
    EDITTEXT        IDC_METRO_MIN_10,385,160,55,12,ES_AUTOHSCROLL

    // Buttons
    PUSHBUTTON      "ЗАПИСАТЬ КОМАНДУ",IDC_METRO_BTN_WRITE_CMD,7,213,150,18
    PUSHBUTTON      "ОТКРЫТЬ_ФАЙЛ",IDC_METRO_BTN_OPEN_FILE,7,236,150,18
