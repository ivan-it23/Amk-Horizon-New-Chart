/////////////////////////////////////////////////////////////////////////////
//
// Значок
//

// Значок с наименьшим значением идентификатора помещается первым, чтобы гарантировать использование
// идентичного значка приложения для всех систем.

IDI_AMKHORIZONNEWCHART       ICON         "Amk-Horizon-New-Chart.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Меню
//

IDC_AMKHORIZONNEWCHART MENU
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Открыть файл данных...",   IDM_OPEN_FILE
        MENUITEM SEPARATOR
        MENUITEM "Вы&ход",                    IDM_EXIT
    END

    POPUP "&Прибор"
    BEGIN
        MENUITEM "&Подключить...",            IDM_DEVICE_CONNECT
        MENUITEM "&Отключить",                IDM_DEVICE_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&Старт опроса",             IDM_DEVICE_START
        MENUITEM "С&топ опроса",              IDM_DEVICE_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Очистить данные",          IDM_DEVICE_CLEAR
        MENUITEM "Метрология...",             IDM_DEVICE_METROLOGY
        MENUITEM SEPARATOR
        MENUITEM "Папка &записи...",          IDM_DEVICE_RECORD_FOLDER
        MENUITEM "Открыть папку записи",      IDM_DEVICE_OPEN_FOLDER
    END

    POPUP "&Справка"
    BEGIN
        MENUITEM "&О программе...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Ускоритель
//

IDC_AMKHORIZONNEWCHART ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


