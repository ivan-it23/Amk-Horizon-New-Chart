    EDITTEXT        IDC_METRO_AIR_5,250,86,55,12,ES_AUTOHSCROLL
    LTEXT           "AIR_1_F_2",IDC_STATIC,200,106,45,10
    EDITTEXT        IDC_METRO_AIR_6,250,104,55,12,ES_AUTOHSCROLL
    LTEXT           "AIR_2_F_2",IDC_STATIC,200,120,45,10
    EDITTEXT        IDC_METRO_AIR_7,250,118,55,12,ES_AUTOHSCROLL
